{
  "Arena": {
    "Id": "sp500",
    "DisplayName": "S&P 500"
  },
  "ConnectionStrings": {
    "AlphaLab": "Data Source=E:/AlphaLabDatabase/{Arena.Id}/alphalab.db"
  },
  "Urls": "http://127.0.0.1:5230",
  "Llm": {
    "DailyBudget": {
      "MaxCostUsd": 1.0,
      "MaxCalls": 10,
      "MaxTokens": 0
    }
  },
  "Api": {
    "OpenApi": "native",
    "CorsAllowedOrigins": [ "http://localhost:5210" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
